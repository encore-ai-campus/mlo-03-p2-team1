# 공공데이터포털 마이페이지 > 일반 인증키(Decoding)
DATA_GO_KR_KEY=

# 서울 열린데이터광장 > 인증키 신청 (일반 인증키). 서울 인허가 수집용 (python pipeline/source/00_collect.py seoul)
DATA_SEOUL_GO_KR_KEY=

# FastAPI PostgreSQL 연결 (기본값: 로컬 Docker Compose --profile local-db 바로 실행용)
# cp .env.example .env && docker compose --profile local-db up --build -d
DBHOST=postgres
DBPORT=5432
DBNAME=web
DBID=web
DBPW=localdev
DBSSLMODE=disable

# 팀 공용 PostgreSQL 연결 시 위 값 대신 아래 값으로 교체하세요:
# DBHOST=100.100.100.60
# DBPORT=5432
# DBNAME=web
# DBID=web
# DBPW=<팀_DB_비밀번호>
# DBSSLMODE=require
